# Supabase (fixtures, squads, leaderboard data — still used by upstream APIs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Project Settings → API → service_role (secret). Required for selections, leaderboard, fixture cache.
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth (required for login)
NEXTAUTH_URL=http://localhost:3000
# Production (Vercel): https://your-project.vercel.app — see docs/VERCEL.md
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Postgres (Supabase → Database → Connection pooling → Session mode for Vercel)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Optional: cap app-side pool size (default 4 local, 2 on Vercel). Supabase session pooler ~15 total.
# PG_POOL_MAX=2
# Direct db.[PROJECT_REF].supabase.co works locally sometimes but often fails on Vercel (ENOTFOUND)
# Set to false only for local Postgres without SSL
# DATABASE_SSL=false

# Cricket data (Sportmonks — required for /matches fixtures)
# Sign up at https://www.sportmonks.com/cricket-api/ and copy your token.
SPORTMONKS_API_TOKEN=
# Optional: league to seed player pool from (auto-detects if unset; e.g. 5 = Big Bash League)
# SPORTMONKS_LEAGUE_ID=5

# Planned
# CRICAPI_KEY=
