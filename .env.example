# Supabase (fixtures, squads, leaderboard data — still used by upstream APIs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Project Settings → API → service_role (secret). Required for selections, leaderboard, fixture cache.
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth (required for login)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Postgres connection (Supabase → Project Settings → Database → URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Set to false only for local Postgres without SSL
# DATABASE_SSL=false

# Cricket data (Sportmonks — required for /matches fixtures)
# Sign up at https://www.sportmonks.com/cricket-api/ and copy your token.
SPORTMONKS_API_TOKEN=

# Planned
# CRICAPI_KEY=
